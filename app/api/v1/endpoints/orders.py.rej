+@admin_router.get("/orders")
+async def list_orders(
+    session: DbSession,
+    actor: Annotated[User, Depends(require_operations)],
+    status_filter: Annotated[OrderStatus | None, Query(alias="status")] = None,
+    source: Annotated[OrderSource | None, Query()] = None,
+    scheduled_date: Annotated[date | None, Query()] = None,
+    area: Annotated[str | None, Query()] = None,
+    page: int = Query(1, ge=1),
+    page_size: int = Query(PAGE_SIZE, ge=1, le=200),
+) -> dict[str, Any]:
+    stmt = select(Order)
+    count_stmt = select(sa_func.count()).select_from(Order)
+
+    if status_filter:
+        stmt = stmt.where(Order.status == status_filter)
+        count_stmt = count_stmt.where(Order.status == status_filter)
+    if source:
+        stmt = stmt.where(Order.source == source)
+        count_stmt = count_stmt.where(Order.source == source)
+    if scheduled_date:
+        stmt = stmt.where(Order.scheduled_date == scheduled_date)
+        count_stmt = count_stmt.where(Order.scheduled_date == scheduled_date)
+    if area:
+        stmt = stmt.where(Order.area == area)
+        count_stmt = count_stmt.where(Order.area == area)
+
+    total = (await session.scalar(count_stmt)) or 0
+    total_pages = max(1, (total + page_size - 1) // page_size)
+
+    stmt = (
+        stmt.order_by(Order.scheduled_date.desc(), Order.created_at.desc())
+        .offset((page - 1) * page_size)
+        .limit(page_size)
+    )
+    items = list((await session.scalars(stmt)).all())
+
+    # Serialize items manually since we can't use response_model with dynamic types
+    serialized = []
+    for o in items:
+        serialized.append({
+            "id": str(o.id),
+            "order_code": o.order_code,
+            "service_id": str(o.service_id),
+            "service_name": o.service_name,
+            "source": o.source.value,
+            "status": o.status.value,
+            "customer_name": o.customer_name,
+            "customer_phone": o.customer_phone,
+            "scheduled_date": o.scheduled_date.isoformat(),
+            "scheduled_slot": o.scheduled_slot,
+            "estimated_hours": float(o.estimated_hours) if o.estimated_hours else None,
+            "amount": float(o.amount) if o.amount else None,
+            "created_at": o.created_at.isoformat(),
+        })
+
+    return {
+        "items": serialized,
+        "total": total,
+        "page": page,
+        "page_size": page_size,
+        "total_pages": total_pages,
+    }
 
 
 @admin_router.post("/orders", response_model=OrderDetailResponse, status_code=status.HTTP_201_CREATED)
