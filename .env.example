ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://home_shine:home_shine@db:5432/home_shine
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOG_LEVEL=INFO
